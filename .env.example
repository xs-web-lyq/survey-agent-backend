# ============ 迁移时唯一需要修改的文件 ============

# RAG-Anything 源码目录(sys.path 注入用)
RAG_ANYTHING_REPO=/opt/rag-anything

# 知识库存储目录(LightRAG working_dir,只读)
RAG_STORAGE_DIR=/srv/survey-agent/rag-storage/casting_ems_v1_plus_v2_core

# 章节学术索引(progressive 链路用;留空则自动尝试 RAG_STORAGE_DIR 同级 indexes 目录)
ACADEMIC_INDEX_PATH=/srv/survey-agent/indexes/casting_ems_v1_plus_v2_core_academic_index/academic_index.json

# MinerU 解析产物根目录(分号分隔多个;引用溯源卡显示原文图片用,可留空)
# 配置后运行 python scripts/build_image_index.py 生成索引
PARSER_OUTPUT_DIRS=/srv/survey-agent/parsed;/opt/rag-anything/output

# ============ LLM ============
# 协议:openai(/chat/completions 兼容端点)| anthropic(messages 协议中转站)
LLM_BINDING_TYPE=openai
LLM_BINDING_API_KEY=sk-xxx
LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
# 综述撰写阶段可用更强模型(留空复用 LLM_MODEL)
WRITER_MODEL=
# 临时限流/模型服务失败的自动重试(流式调用只在首个片段输出前重试)
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.8

# --- 示例:opencode zen 中转站(Anthropic messages 协议)---
# LLM_BINDING_TYPE=anthropic
# LLM_BINDING_API_KEY=你的 OPENCODE_GO_API_KEY
# LLM_BINDING_HOST=https://opencode.ai/zen/go
# LLM_MODEL=qwen3.7-plus

# ============ Embedding(本地 SentenceTransformers,与入库时一致)============
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu   # 服务器上有 GPU 改为 cuda

# ============ 应用配置(一般无需修改)============
# WORKSPACE_DIR=/srv/survey-agent/workspace
# DATA_DIR=/srv/survey-agent/app-data
# FRONTEND_DIST_DIR=/opt/survey-agent/frontend/dist
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000
# APP_ENV=production
# DEBUG=false
# 默认懒初始化，确保健康端点立即响应；维护窗口需要预热时显式开启。
# STARTUP_RAG_WARMUP=false
# 生产同源部署可留空；前后端分离时填写逗号分隔的精确来源，禁止使用 *。
# CORS_ORIGINS=https://research.example.com
# 保护显式模型预检接口 /api/admin/preflight/model。
# ADMIN_TOKEN=replace-with-a-long-random-secret
# MODEL_PREFLIGHT_TIMEOUT_SECONDS=15

# ============ Conversation memory ============
# Number of recent normalized messages passed verbatim to the LLM.
# MEMORY_RECENT_MESSAGES=8
# Create a versioned summary after either threshold is exceeded.
# MEMORY_COMPACT_AFTER_MESSAGES=16
# MEMORY_COMPACT_AFTER_CHARS=24000
# Maximum relevant long-term memories injected into one turn.
# MEMORY_MAX_DURABLE_ITEMS=5
# Background compaction/extraction idle threshold in seconds.
# MEMORY_IDLE_EXTRACT_SECONDS=600
# Optional LLM fallback for ambiguous query rewriting (deterministic by default).
# MEMORY_LLM_REWRITE=false
